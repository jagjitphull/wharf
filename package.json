{
  "name": "wharf",
  "productName": "Wharf",
  "desktopName": "wharf.desktop",
  "version": "0.1.0",
  "description": "A personal SSH/SFTP terminal client.",
  "author": "Wharf",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && npm run build:main && npm run build:preload && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main/preload.js --external:electron",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "start": "electron .",
    "package": "npm run build && electron-builder --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{js,mjs,json,md}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{js,mjs,json,md}\" \".github/**/*.yml\"",
    "smoke": "node scripts/smoke-test.mjs",
    "postinstall": "node scripts/verify-pty.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@google/genai": "^2.22.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "node-pty": "^1.1.0",
    "openai": "^7.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.16.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wait-on": "^7.2.0",
    "ws": "^8.22.0"
  }
}
